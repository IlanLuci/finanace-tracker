# Plaid credentials for auto-account-sync.
# Sign up at https://dashboard.plaid.com/ to get these.
# Plaid retired the Development environment in 2024 — dashboard tiers
# formerly called "Development" now issue Production credentials.
# Use sandbox for testing, production for real accounts.
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_or_production_secret_here

# One of: sandbox | production. Default: sandbox.
PLAID_ENV=production

# Optional — Plaid Link UI customization.
PLAID_CLIENT_NAME=Finance Tracker
PLAID_COUNTRY_CODES=US
PLAID_LANGUAGE=en
